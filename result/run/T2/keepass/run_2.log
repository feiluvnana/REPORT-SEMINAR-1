onale\": \"Clause attachment allows two readings: an entry can only be created inside an existing group, or a group requires an entry in order to be created.\"\n    },\n    {\n      \"req_id\": \"KP-011\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_error_handling\",\n      \"evidence\": \"An entry must belong to a group to be created\",\n      \"related_ids\": [],\n      \"rationale\": \"Passive phrasing omits the actor and does not specify what happens if entry creation is attempted when no group is selected or available.\"\n    },\n    {\n      \"req_id\": \"KP-012\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_error_handling\",\n      \"evidence\": \"When the password field is completed the repeat password field must be completed\",\n      \"related_ids\": [],\n      \"rationale\": \"Omits which screen/operation this applies to (entry vs. master password), the actor/validator, and the system behavior if the repeat password field is left blank.\"\n    },\n    {\n      \"req_id\": \"KP-013\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_error_handling\",\n      \"evidence\": \"Password field and repeat password field must be identical\",\n      \"related_ids\": [],\n      \"rationale\": \"States a password-matching validation rule without specifying which context it applies to or what error handling occurs when the two fields differ.\"\n    },\n    {\n      \"req_id\": \"KP-014\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_actor\",\n      \"evidence\": \"An entry must be selected to be viewed or modified\",\n      \"related_ids\": [],\n      \"rationale\": \"Passive voice omits the actor performing selection/viewing/modification and does not specify what happens if view or modify is invoked with no entry selected.\"\n    },\n    {\n      \"req_id\": \"KP-015\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_error_handling\",\n      \"evidence\": \"When the password field is changed the repeat password field must be Changed and be identical with password field\",\n      \"related_ids\": [],\n      \"rationale\": \"Passive phrasing omits the actor, applicable screen/context, and error behavior when the repeat password field is not updated or does not match.\"\n    },\n    {\n      \"req_id\": \"KP-015\",\n      \"type\": \"inconsistency\",\n      \"subtype\": \"duplicate\",\n      \"evidence\": \"When the password field is changed the repeat password field must be Changed and be identical with password field\",\n      \"related_ids\": [\n        \"KP-012\",\n        \"KP-013\"\n      ],\n      \"rationale\": \"Restates the repeat-password completion and equality rules already established in KP-012 and KP-013 without establishing a distinct scope or differing policy.\"\n    },\n    {\n      \"req_id\": \"KP-016\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_actor\",\n      \"evidence\": \"An entry must be selected before it is duplicated\",\n      \"related_ids\": [],\n      \"rationale\": \"Passive voice omits the actor and system component performing duplication and does not specify what happens if duplication is attempted without a selected entry.\"\n    },\n    {\n      \"req_id\": \"KP-017\",\n      \"type\": \"ambiguity\",\n      \"subtype\": \"referential\",\n      \"evidence\": \"For the following features, use cases are not included\",\n      \"related_ids\": [],\n      \"rationale\": \"'the following features' has an unclear scope/reference across subsequent requirements, leaving unclear whether those features are out of scope or merely lack use-case documentation; 'a browser' is also unspecified.\"\n    },\n    {\n      \"req_id\": \"KP-017\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_error_handling\",\n      \"evidence\": \"An internet connection and a browser are required in order to download new language translations For the following features, use cases are not included\",\n      \"related_ids\": [],\n      \"rationale\": \"External dependencies (internet connection and browser) lack failure/offline error handling and actor ownership, and omitting use cases leaves behavioral details for following features incomplete.\"\n    },\n    {\n      \"req_id\": \"KP-018\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_condition\",\n      \"evidence\": \"The prefix “Auto-Type:” is required in front of each sequence\",\n      \"related_ids\": [],\n      \"rationale\": \"Does not specify where sequences are defined (e.g., an entry's note field) or what happens if the 'Auto-Type:' prefix is missing or malformed.\"\n    },\n    {\n      \"req_id\": \"KP-019\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_error_handling\",\n      \"evidence\": \"Sequence’s length must not be more than a line (59 characters)\",\n      \"related_ids\": [],\n      \"rationale\": \"Does not specify what happens when a sequence exceeds 59 characters (e.g., rejected, truncated, or ignored), nor whether the 59-character limit includes the 'Auto-Type:' prefix.\"\n    },\n    {\n      \"req_id\": \"KP-020\",\n      \"type\": \"incompleteness\",\n      \"subtype\": \"missing_error_handling\",\n      \"evidence\": \"If two auto-types are referred in one note field, only the first is used\",\n      \"related_ids\": [],\n      \"rationale\": \"Passive voice omits the executing component, does not cover more than two auto-types in one note field, and omits whether extra auto-types are silently ignored or produce a warning/error.\"\n    },\n    {\n      \"req_id\": \"KP-020\",\n      \"type\": \"inconsistency\",\n      \"subtype\": \"terminology\",\n      \"evidence\": \"two auto-types\",\n      \"related_ids\": [\n        \"KP-018\",\n        \"KP-019\"\n      ],\n      \"rationale\": \"Uses the term 'auto-types' instead of the term 'sequence' / 'Sequence' (with 'Auto-Type:' prefix) established in KP-018 and KP-019.\"\n